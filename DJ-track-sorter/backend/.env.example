# Comma-separated list of origins allowed to call this API.
# Add your deployed frontend URL (Vercel/Netlify) here in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Max size per uploaded track, in MB. Default is 5GB (5120). There's no
# separate limit on how many tracks can be uploaded at once.
MAX_FILE_SIZE_MB=5120
